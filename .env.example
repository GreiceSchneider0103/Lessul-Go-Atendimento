NODE_ENV=development
# Runtime (pooling / pgbouncer)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# Migrations (pooler em modo sessão)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
APP_BASE_URL=https://your-deployment-domain.example.com

# E-mail transacional (redefinição de senha usa o mailer nativo do Supabase;
# estas variáveis só são necessárias para as notificações via Resend,
# ex.: aviso de nova tarefa operacional e devolução recebida)
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM=<remetente@seudominio.com>
